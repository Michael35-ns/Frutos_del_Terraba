@model List<Frutos_del_Terraba.Models.EmpleadoModel>

    <h2>Lista de Empleados</h2>
    <a asp-action="Create" class="btn btn-primary">Agregar Empleado</a>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Nombre de Usuario</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var empleado in Model)
        {
            <tr>
                <td>@empleado.Id</td>
                <td>@empleado.Email</td>
                <td>@empleado.UserName</td>
                <td>@empleado.Role</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@empleado.Id" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@empleado.Id" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
