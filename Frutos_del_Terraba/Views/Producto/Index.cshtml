@model IEnumerable<Frutos_del_Terraba.Models.ProductoViewModel>

@{
    ViewData["Title"] = "Lista de Productos";
}

<div class="card m-5">
    <div class="card-header">
        <h5 class="mb-3">Lista de Productos</h5>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <!-- Buscador -->
            <div class="dt-search d-flex align-items-center">
                <input type="search" class="dt-input form-control form-control-sm" id="dt-search-0 placeholder="Buscar..." aria-controls="DataTables_Table_0">
            </div>
            <!-- Selector de longitud -->
            <div class="d-flex align-items-center ms-auto">
                <div class="d-flex align-items-center me-3">
                    <select name="DataTables_Table_0_length" aria-controls="DataTables_Table_0" class="form-select form-select-sm w-auto">
                        <option value="7">7</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>
            <a class="btn btn-primary" href="@Url.Action("Crear", "Producto")">
                <i class="ri-add-line"></i> Agregar Producto
            </a>
        </div>
    </div>

    <!-- Tabla de Productos -->
    <div class="table-responsive m-2">
        <table class="table dataTable no-footer" id="DataTables_Table_0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Stock</th>
                    <th>Categoría</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td>@producto.IdProducto</td>
                            <td>@producto.Nombre</td>
                            <td>@producto.Stock</td>
                            <td>@producto.NombreCategoria</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="ri-more-2-line"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Editar" asp-route-id="@producto.IdProducto">
                                                <i class="ri-pencil-line me-1"></i> Editar
                                            </a>
                                        </li>
                                        <li>
                                            <form asp-action="Eliminar" asp-route-id="@producto.IdProducto" method="post" class="delete-form">
                                                <button type="submit" class="dropdown-item text-danger" style="border: none; background: transparent; padding: 0; margin: 0;">
                                                    <i class="ri-delete-bin-6-line me-1"></i> Eliminar
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay productos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
