@model IEnumerable<Frutos_del_Terraba.Models.ProductoViewModel>

@{
    ViewData["Title"] = "Lista de Productos";
}

<div class="card m-5">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-3">Lista de Productos</h5>
            <a class="btn btn-primary" href="@Url.Action("Create", "Producto")">
                <i class="ri-add-line"></i> Agregar Producto
            </a>
        </div>
    </div>

    <!-- Tabla de Productos -->
    <div class="table-responsive m-2">
        <table class="table dataTable no-footer" id="DataTables_Table_0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td>@producto.Nombre</td>
                            <td>@producto.NombreCategoria</td>
                            <td class="d-flex gap-2">
                                <a class=" btn btn-outline-dark" asp-action="Edit" asp-route-id="@producto.IdProducto">
                                    <i class="ri-pencil-line me-1"></i>
                                </a>
                                <a href="#" class="btn btn-outline-danger" title="Eliminar"
                                   onclick="confirmDelete('producto', '@producto.IdProducto', '/Producto/Delete/@producto.IdProducto')">
                                    <i class="ri-delete-bin-6-line me-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay productos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
