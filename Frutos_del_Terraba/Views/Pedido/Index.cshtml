@model Frutos_del_Terraba.Models.PedidoViewModel

@{
    ViewData["Title"] = "Lista de Pedidos";
}

<h2>Lista de Pedidos</h2>

<table class="table dataTable" id="DataTables_Table_0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Proveedor</th>
            <th>Fecha</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pedido in Model.Pedido)
        {
            <tr>
                <td>@pedido.Id_pedido</td>
                @foreach (var proveedor in Model.Proveedores)
                {
                    if(proveedor.Id_proveedor == pedido.Id_proveedor)
                    {
                    <td>@proveedor.Nombre</td>
                    }
                }
                <td>@pedido.Fecha.ToShortDateString()</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@pedido.Id_pedido" class="btn btn-outline-warning" title="Editar">
                        <i class="ri-edit-line"></i>
                    </a>
                    <a asp-action="Eliminar" asp-route-id="@pedido.Id_pedido" class="btn btn-outline-danger" onclick="return confirm('¿Estás seguro de eliminar este pedido?');" title="Eliminar">
                        <i class="ri-delete-bin-line"></i>
                    </a>
                    <a asp-action="Create" asp-controller="DetallePedido" asp-route-id="@pedido.Id_pedido" class="btn btn-outline-info" title="Agregar Detalles">
                        <i class="ri-add-circle-line"></i>
                    </a>
                    <a asp-action="VerDetallesPedido" asp-controller="DetallePedido" asp-route-id="@pedido.Id_pedido" class="btn btn-outline-success" title="Ver Detalles">
                        <i class="ri-eye-line"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>Agregar Nuevo Pedido</h2>
<form asp-action="Crear" method="post">
    <div class="form-group">
        <label asp-for="Id_usuario">Usuario</label>
        <input type="text" class="form-control" name="UserId" required />
    </div>

    <div class="form-group">
        <label asp-for="Id_proveedor">Proveedor</label>
        <select class="form-control" name="Id_proveedor" required>
            <option value="">Selecciona un proveedor</option>
            @foreach (var proveedor in Model.Proveedores)
            {
                <option value="@proveedor.Id_proveedor">@proveedor.Nombre</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Fecha">Fecha</label>
        <input type="date" class="form-control" name="Fecha" required />
    </div>
    <br />
    <button type="submit" class="btn btn-outline-primary">Agregar Pedido</button>
</form>
