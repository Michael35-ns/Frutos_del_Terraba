@{
    TempData.Keep();
    string? currentPage = ViewContext.HttpContext.Request.Path;
}

<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
    <div class="app-brand demo text-center">
        <a asp-controller="Dashboards" asp-action="Index" class="app-brand-link d-flex flex-column align-items-center">
            <div class="brand-container d-flex flex-column align-items-center">
                <img src="~/img/logo.png" alt="Logo" class="rounded-circle brand-logo mb-3">
                <span class="app-brand-text fw-bold text-wrap text-center">
                    Frutos del Térraba
                </span>
            </div>
        </a>
    </div>
    @* ! Full version menu-items *@
    <ul class="menu-inner py-1">
        <!-- Productos -->
        <li class='menu-item@(currentPage.StartsWith("/Producto") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ri-box-3-line"></i>
                <div>Productos</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Producto/Index" ? " active" : "")'>
                    <a asp-controller="Producto" asp-action="Index" class="menu-link">
                        <div>Ver Productos</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Producto/Create" ? " active" : "")'>
                    <a asp-controller="Producto" asp-action="Create" class="menu-link">
                        <div>Agregar Productos</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Categoria/Index" ? " active" : "")'>
                    <a asp-controller="Categoria" asp-action="Index" class="menu-link">
                        <div>Categorias</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Pedidos -->
        <li class='menu-item@(currentPage.StartsWith("/Pedido") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ri-draft-line"></i>
                <div> Pedidos</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Pedido/Index" ? " active" : "")'>
                    <a asp-controller="Pedido" asp-action="Index" class="menu-link">
                        <div>Ver Pedidos</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Distribución-->
        <li class='menu-item@(currentPage.StartsWith("/Distribucion") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ri-caravan-line"></i>
                <div>Distribución</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Distribucion/Index" ? " active" : "")'>
                    <a asp-controller="Distribucion" asp-action="Index" class="menu-link">
                        <div>Ver Distribuciones</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Distribucion/Create" ? " active" : "")'>
                    <a asp-controller="Distribucion" asp-action="Create" class="menu-link">
                        <div>Nuevo Envío</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Distribucion/Reporte" ? " active" : "")'>
                    <a asp-controller="Distribucion" asp-action="Reporte" class="menu-link" target="_blank">
                        <div>Generar Reporte</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Inventario-->
        <li class='menu-item@(currentPage.StartsWith("/Inventario") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ri-stock-line"></i>
                <div>Inventario</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Inventario/Index" ? " active" : "")'>
                    <a asp-controller="Inventario" asp-action="Index" class="menu-link">
                        <div>Ver Inventario</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Inventario/Despachado" ? " active" : "")'>
                    <a asp-controller="Inventario" asp-action="Despachado" class="menu-link">
                        <div>Inventario Despachado</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Proveedores-->
        <li class='menu-item@(currentPage.StartsWith("/Proveedor") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ri-group-line"></i>
                <div>Proveedores</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Proveedor/Index" ? " active" : "")'>
                    <a asp-controller="Proveedor" asp-action="Index" class="menu-link">
                        <div>Ver Proveedores</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Proveedor/Create" ? " active" : "")'>
                    <a asp-controller="Proveedor" asp-action="Create" class="menu-link">
                        <div>Añadir Proveedores</div>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Reportes-->
        <li class='menu-item@(currentPage.StartsWith("/Reportes") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="ri-bar-chart-grouped-line"></i>
                <div>Reportes</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Reporte/Index" ? " active" : "")'>
                    <a href="@Url.Action("Index", "Reporte")" class="menu-link">
                        <div>Ver Reportes</div>
                    </a>
                </li>
                <li class='menu-item@(currentPage == "/Reporte/Create" ? " active" : "")'>
                    <a href="@Url.Action("Create", "Reporte")" class="menu-link">
                        <div>Crear Reporte</div>
                    </a>
                </li>
            </ul>
        </li>
    </ul>
</aside>
<!-- / Menu -->