@model IEnumerable<Frutos_del_Terraba.Models.DistribucionViewModel>

@{
    ViewData["Title"] = "Lista de Inventario";
}

<div class="card m-5">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-3">Lista de Inventario</h5>
            <a class="btn btn-primary" href="@Url.Action("Create", "Distribucion")">
                <i class="ri-add-line">Nuevo Envío</i>
            </a>
        </div>
    </div>

    <!-- Tabla de Productos -->
    <div class="table-responsive m-2">
        <table class="table dataTable no-footer" id="DataTables_Table_0">
            <thead>
                <tr>
                    <th>Usuario que aprobo el envio</th>
                    <th>Destino</th>
                    <th>Ubicacion</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var distribucion in Model)
                    {
                        <tr>
                            <td>@distribucion.Usuario.UserName</td>
                            <td>@distribucion.Destino</td>
                            <td>@distribucion.Ubicacion</td>
                            <td class="d-flex gap-2">
                                <a class=" btn btn-outline-info" asp-action="Show" asp-route-id="@distribucion.Id_distribucion">
                                    <i class="ri-eye-line me-1"></i>
                                </a>
                                <a class=" btn btn-outline-dark" asp-action="Edit" asp-route-id="@distribucion.Id_distribucion">
                                    <i class="ri-pencil-line me-1"></i>
                                </a>
                                <a href="#" class="btn btn-outline-danger" title="Eliminar" onclick="confirmDelete('distribucion', '@distribucion.Id_distribucion', '/Distribucion/Delete/{id}')">
                                    <i class="ri-delete-bin-6-line me-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay distribuciones registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
