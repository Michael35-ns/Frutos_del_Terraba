@model Frutos_del_Terraba.Models.ReporteViewModel

@{
    ViewData["Title"] = "Editar Reporte";

    var productos = ViewBag.Productos as List<SelectListItem>;
    var nombreProducto = productos?.FirstOrDefault(p => p.Value == Model.Id_producto.ToString())?.Text ?? "Producto no encontrado";
}

<div class="container my-5">
    <div class="card">
        <h5 class="card-header">Editar Reporte</h5>
        <div class="card-body demo-vertical-spacing demo-only-element">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id_reporte" />
                <input type="hidden" asp-for="Id_producto" />
                <input type="hidden" asp-for="Fecha" />

                <div class="form-floating form-floating-outline mb-3">
                    <input class="form-control" type="text" value="@nombreProducto" readonly />
                    <label>Producto</label>
                </div>

                <div class="form-floating form-floating-outline mb-3">
                    <input asp-for="Cantidad_reportada" class="form-control" type="number" placeholder="Ingrese la cantidad reportada" required />
                    <label asp-for="Cantidad_reportada">Cantidad Reportada</label>
                    <span asp-validation-for="Cantidad_reportada" class="text-danger"></span>
                </div>

                <div class="form-floating form-floating-outline mb-3">
                    <textarea asp-for="Motivo" class="form-control" placeholder="Ingrese el motivo del reporte" rows="3" required></textarea>
                    <label asp-for="Motivo">Motivo del Reporte</label>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>

                <div class="form-floating form-floating-outline mb-3">
                    <input class="form-control" type="date" value="@Model.Fecha.ToString("yyyy-MM-dd")" disabled />
                    <label asp-for="Fecha">Fecha del Reporte</label>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

