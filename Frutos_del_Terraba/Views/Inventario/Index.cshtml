@model IEnumerable<Frutos_del_Terraba.Models.InventarioViewModel>

@{
    ViewData["Title"] = "Lista de Inventario";
}

<div class="card m-5">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-3">Lista de Inventario</h5>
            <a class="btn btn-primary" href="@Url.Action("Create", "Distribucion")">
                <i class="ri-add-line"></i> Despachar Inventario
            </a>
        </div>
    </div>

    <!-- Tabla de Productos -->
    <div class="table-responsive m-2">
        <table class="table dataTable no-footer" id="DataTables_Table_0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                    <th>Categoria</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var inventario in Model)
                    {
                        <tr>
                            <td>@inventario.Producto.Nombre</td>
                            <td>@inventario.Cantidad</td>
                            <td>@inventario.Producto.Categoria.Nombre</td>
                            <td class="d-flex gap-2">
                                <a class=" btn btn-outline-dark" asp-action="Edit" asp-route-id="@inventario.Id_inventario">
                                    <i class="ri-pencil-line me-1"></i>
                                </a>
                                <a href="#" class="btn btn-outline-danger" title="Eliminar" onclick="confirmDelete('inventario', '@inventario.Id_inventario', '/Inventario/Delete/{id}')">
                                    <i class="ri-delete-bin-6-line me-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay productos en el inventario registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
