@model Frutos_del_Terraba.Models.RegisterModel

@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Registro";
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

<!-- Content -->
<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-6 mx-4">

            <!-- Register Card -->
            <div class="card p-7">
                <!-- Logo -->
                <!-- /Logo -->
                <div class="card-body mt-1">
                    <h4 class="mb-1">Crea una cuenta 🚀</h4>

                    <form id="formAuthentication" class="mb-5" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        }
                        
                        <!-- userName -->
                        <div class="form-floating form-floating-outline mb-5">
                            <input asp-for="userName" class="form-control" placeholder="Nombre de usuario">
                            <label asp-for="userName">Nombre de Usuario</label>
                            <span asp-validation-for="userName" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="form-floating form-floating-outline mb-5">
                            <input asp-for="email" type="email" class="form-control" placeholder="Correo electrónico">
                            <label asp-for="email">Email</label>
                            <span asp-validation-for="email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-5 form-password-toggle">
                            <div class="input-group input-group-merge">
                                <div class="form-floating form-floating-outline">
                                    <input asp-for="password" type="password" class="form-control" placeholder="••••••••" aria-describedby="password" />
                                    <label asp-for="password">Password</label>
                                    <span asp-validation-for="password" class="text-danger"></span>
                                </div>
                                <span class="input-group-text cursor-pointer"><i class="ri-eye-off-line ri-20px"></i></span>
                            </div>
                        </div>

                        <!-- Terms and Conditions -->

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary d-grid w-100 mb-5">
                            Crear Cuenta
                        </button>
                    </form>

                    <!-- Login Link -->
                    <p class="text-center mb-5">
                        <span>Ya tienes una cuenta?</span>
                        <a href="/Auth/Login">
                            <span>Iniciar sesión</span>
                        </a>
                    </p>
                </div>
            </div>
            <!-- /Register Card -->
            <!-- Background Images -->
            <img src="~/img/illustrations/tree-3.png" alt="auth-tree" class="authentication-image-object-left d-none d-lg-block">
            <img src="~/img/illustrations/auth-basic-mask-light.png" class="authentication-image d-none d-lg-block" height="172" alt="triangle-bg" data-app-light-img="illustrations/auth-basic-mask-light.png" data-app-dark-img="illustrations/auth-basic-mask-dark.png">
            <img src="~/img/illustrations/tree.png" alt="auth-tree" class="authentication-image-object-right d-none d-lg-block">
        </div>
    </div>
</div>
