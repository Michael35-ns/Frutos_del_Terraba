@model Frutos_del_Terraba.Models.HistorialProveedorViewModel
@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<h2 class="text-center text-info">Detalles del Proveedor</h2>
<div class="d-flex justify-content-end mt-3">
    <a class="btn btn-primary" asp-action="Index">
        <i class="ri-arrow-left-line me-1"></i> Proveedores
    </a>
</div>
<div class="card m-5">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <h3 class="mb-3 text-info">Información del Proveedor</h3>
                <dl class="row">
                    <dt class="col-sm-4">Nombre:</dt>
                    <dd class="col-sm-8">@Model.Proveedor.Nombre @Model.Proveedor.Apellidos</dd>

                    <dt class="col-sm-4">Teléfono:</dt>
                    <dd class="col-sm-8">@Model.Proveedor.Telefono</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Proveedor.Email</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

 <div class="card m-5">
    <div class="m-4">
        <h3 class="text-info">Historial de Pedidos</h3>
        @if (Model.HistorialPedidos != null && Model.HistorialPedidos.Any())
        {
            <div class="accordion" id="accordionPedidos">
                @foreach (var pedido in Model.HistorialPedidos)
                {
                    <div class="accordion-item mt-2 hover-effect">
                        <h2 class="accordion-header" id="heading-@pedido.Id_pedido">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapse-@pedido.Id_pedido" aria-expanded="false"
                                    aria-controls="collapse-@pedido.Id_pedido">
                                <div class="d-flex flex-column w-100">
                                    <span class="mb-2">Fecha: @pedido.Fecha.ToString("dd/MM/yyyy")</span>
                                    <span>Usuario que aprobó el pedido: @pedido.Usuario.UserName</span>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse-@pedido.Id_pedido" class="accordion-collapse collapse"
                             aria-labelledby="heading-@pedido.Id_pedido">
                            <div class="accordion-body table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th>Cantidad</th>
                                            <th>Observaciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detalle in pedido.DetallesPedidos)
                                        {
                                            <tr>
                                                <td>@detalle.nombreProducto</td>
                                                <td>@detalle.Cantidad</td>
                                                <td>@detalle.Observaciones</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="d-flex justify-content-end mt-4">
                                    <button class="btn btn-info">
                                        <i class="ri-eye-line me-1"></i> Reporte de Pedido
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No hay pedidos registrados para este proveedor.</p>
        }
    </div>
</div>