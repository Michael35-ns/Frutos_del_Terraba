@model IEnumerable<Frutos_del_Terraba.Models.DetallesPedidoViewModel>

<h2>Detalles del Pedido</h2>

<table class="table dataTable" id="DataTables_Table_0">
    <thead>
        <tr>
            <th>Nombre del Producto</th>
            <th>Cantidad</th>
            <th>Observaciones</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model)
        {
            <tr>
                <td>@detalle.nombreProducto</td>
                <td>@detalle.Cantidad</td>
                <td>@detalle.Observaciones</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@detalle.Id_detalle" class="btn btn-outline-warning" title="Editar">
                        <i class="ri-edit-line"></i>
                    </a>
                    <a href="#" class="btn btn-outline-danger" onclick="confirmDelete('Detalle', '@detalle.Id_detalle', '/DetallePedido/Delete/{id}')">
                        <i class="ri-delete-bin-line"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
