@model Frutos_del_Terraba.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Lista de Categorías";
}

<div class="card m-5">
    <div class="card-header">
        <h5 class="mb-3">Lista de Categorías</h5>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <input type="search" class="form-control form-control-sm" placeholder="Buscar..." aria-controls="DataTables_Table_0">
            </div>
            <div class="d-flex align-items-center ms-auto">
                <div class="d-flex align-items-center me-3">
                    <select name="DataTables_Table_0_length" aria-controls="DataTables_Table_0" class="form-select form-select-sm w-auto">
                        <option value="7">7</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddCategory">
                    <i class="ri-add-line"></i> Agregar Categoría
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de Categorías -->
    <div class="table-responsive m-2">
        <table class="table dataTable no-footer" id="DataTables_Table_0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categorias != null && Model.Categorias.Any())
                {
                    foreach (var categoria in Model.Categorias)
                    {
                        <tr>
                            <td>@categoria.Id_categoria</td>
                            <td>@categoria.Nombre</td>
                            <td>@categoria.Descripcion</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="ri-more-2-line"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@categoria.Id_categoria">
                                                <i class="ri-pencil-line me-1"></i> Editar
                                            </a>
                                        </li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@categoria.Id_categoria" method="post" class="delete-form">
                                                <button type="submit" class="dropdown-item text-danger" style="border: none; background: transparent; padding: 0; margin: 0;">
                                                    <i class="ri-delete-bin-6-line me-1"></i> Eliminar
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No hay categorías registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Offcanvas para agregar categoría -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddCategory" aria-labelledby="offcanvasAddCategoryLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasAddCategoryLabel">Agregar Categoría</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="NuevaCategoria.Nombre" class="form-label">Nombre</label>
                <input asp-for="NuevaCategoria.Nombre" class="form-control" />
                <span asp-validation-for="NuevaCategoria.Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NuevaCategoria.Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="NuevaCategoria.Descripcion" class="form-control" rows="4"></textarea>
                <span asp-validation-for="NuevaCategoria.Descripcion" class="text-danger"></span>
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancelar</button>
            </div>
        </form>
    </div>
</div>
