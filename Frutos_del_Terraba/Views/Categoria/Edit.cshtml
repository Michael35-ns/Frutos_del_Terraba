@model Frutos_del_Terraba.Models.Categoria

@{
    Layout = "_ContentNavbarLayout";
    ViewData["Title"] = "Editar Categoría";
}

<div class="container my-5">
    <div class="card">
        <h5 class="card-header">Editar Categoría</h5>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id_categoria" method="post">
                <input type="hidden" asp-for="Id_categoria" />
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre de la categoría" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Ingrese la descripción"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>

        </div>
    </div>
</div>
